# ====================================================================
# Moodle-Bot Environment Configuration
# Copy this file to .env and fill in your values
# ====================================================================

# OpenRouter API Key for AI-powered course summaries & student notifications
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model identifier (Default: free fast model)
AI_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b:free

# Default WhatsApp recipient phone number (country code + number without '+')
# Example for Sri Lanka: 94767123456
DEFAULT_PHONE_NUMBER=
