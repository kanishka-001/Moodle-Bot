        "groupmode": 0
      },
      {
        "id": 304,
        "name": "English to Sinhala Glossary An English to Sinhala ...",
        "instance": 9,
        "contextid": 15230,
        "description": "<div class=\"no-overflow\"><ul id=\"yui_3_17_2_1_1780849951775_905\">\r\n<li id=\"yui_3_17_2_1_1780849951775_906\">\r\n<p id=\"yui_3_17_2_1_1780849951775_907\"><strong id=\"yui_3_17_2_1_1780849951775_908\">English to Sinhala Glossary</strong></p>\r\n</li>\r\n</ul>\r\n<p><span id=\"yui_3_17_2_1_1780849951775_910\">An English to Sinhala glossary is included in each chapter manual. It was developed by the lecturers of the Department of Accounting.<br id=\"yui_3_17_2_1_1780849951775_911\"><br id=\"yui_3_17_2_1_1780849951775_912\"></span></p>\r\n<ul id=\"yui_3_17_2_1_1780849951775_913\">\r\n<li id=\"yui_3_17_2_1_1780849951775_914\">\r\n<p id=\"yui_3_17_2_1_1780849951775_915\"><strong id=\"yui_3_17_2_1_1780849951775_916\">English to Tamil Glossary</strong></p>\r\n</li>\r\n</ul>\r\n<p><span id=\"yui_3_17_2_1_1780849951775_917\">An English to Tamil glossary will be uploaded to the LMS under each topic separately. These were developed by AFMA, the student body of the Department of Accounting, and have been reviewed by a university professor. If you have any comments or concerns regarding the English to Tamil glossary, please email them to </span>amalihenadirage@sjp.ac.lk.<br><br> Thank you!</p></div>",
        "visible": 1,
        "uservisible": true,
